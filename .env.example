# API autentimine
API_APP_SECRET=sinu_app_secret_siia
API_PRIVATE_KEY=sinu_private_key_siia

# Element14 / Farnell UK API
ELEMENT14_API_KEY=sinu_key_siia


# Analüütika andmebaas (Neon)
# Kopeeri ühendusstring Neon konsoolis: Dashboard → Project → Connection string
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require

# dbt ühendus — täida samade andmetega mis DATABASE_URL-is
POSTGRES_HOST=ep-xxx.region.aws.neon.tech
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=dbname

# Airflow
AIRFLOW_UID=50000
AIRFLOW_USER=airflow
AIRFLOW_PASSWORD=airflow
AIRFLOW_DB=airflow
AIRFLOW_PORT_HOST=8083

# Superset metaandmebaas
SUPERSET_DB_USER=superset
SUPERSET_DB_PASSWORD=muuda_mind
SUPERSET_DB_NAME=superset_meta

# Superset rakendus
SUPERSET_SECRET_KEY=genereeri_pikk_juhuslik_string_siin
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=admin
SUPERSET_ADMIN_EMAIL=admin@example.com
SUPERSET_PORT_HOST=8090
